---
import HeaderLink from "./HeaderLink.astro";
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
---

<header>
	<nav>
		<a href="/" class="header-group">
			<img src=`${config.siteLogo}` 
			     alt=`${config.siteTitle} logo` 
					 width="72" 
					 height="72"
					 class="header-group-logo" />
			<div class="header-group-text">
				<h2>{config.siteTitle}</h2>
				<h3>{config.siteTagline}</h3>
			</div>
	  </a>
		<div class="header-links">
			{
				config.navigation.map((nav) => (
					<HeaderLink href={nav.link} className={nav.classes}>
						{nav.title}
					</HeaderLink>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1000;
		backdrop-filter: blur(40px);
		margin: 0;
		background: #ffffff01;
		padding: 1rem 2rem;
	}
	.header-group {
		display: flex;
		align-items: stretch;
		margin: 0;
		padding: 0;
	}
	.header-group-logo {
		margin-right: 1.2rem;
		width: 3rem;
		height: 4.3rem;
	}
	.header-group-text {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.header-group {
		color: black;
		text-decoration: none;
	}
	.header-group-text h2 {
		width: 145px;
		line-height: 1.1;
		font-family: var(--font-serif);
	}
	.header-group-text h3 {
		width: 7rem;
		font-size: 0.7rem;
		font-family: var(--font-sans);
	}
	h3 {
		margin: 0;
		font-size: 0.8em;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.header-links a {
		border-bottom: 4px solid transparent;
		padding: var(--button-padding);
		color: var(--black);
	}
	.header-links a.active {
    background: -webkit-linear-gradient(318deg, var(--purple), var(--blue));
		-webkit-text-fill-color: transparent;
    -webkit-background-clip: text;
	}
</style>
