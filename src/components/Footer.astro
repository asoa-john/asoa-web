---
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
const today = new Date();
---
<div class="footer">
	<div class="footer-banner-content">
		<img src="/asoa.svg" alt="Applied Scholastics Online Academy" />
	</div>
</div>
	<footer class="copyright-footer">
		&copy; {today.getFullYear()}
		{console.log(config)}
		{config.seo.siteOwner}. All rights reserved.
		<div class="social-links">
			{
				config?.social?.map((url) => {
					return (
						<IconLink {...url} />
					); 
				})
			}
		</div>
	</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slideshows = document.querySelectorAll('.gallery.slideshow');
    
    slideshows.forEach((gallery) => {
      const figures = gallery.querySelectorAll('.gallery-grid figure');
      if (figures.length <= 1) return;
      
      const duration = parseInt(gallery.dataset.slideDuration || '5000');
      let currentIndex = 0;
      
      // First slide already has 'current' class from render
      
      setInterval(() => {
        figures[currentIndex].classList.remove('current');
        currentIndex = (currentIndex + 1) % figures.length;
        figures[currentIndex].classList.add('current');
      }, duration);
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slidetexts = document.querySelectorAll('.slidetext');
    slidetexts.forEach((span) => {
      let revealIndex = 0;
      const words = span.innerText.split(',');
      span.innerText = '';
      words.forEach((str,index) => {
        const word = document.createElement('span');
        word.classList.add('slidetext-word');
				if(index == 0){
          word.classList.add('reveal');
        }
        word.innerText = str.trimStart();
        span.append(word);
      });
      const slidetextWords = span.querySelectorAll('.slidetext-word');

      setInterval(() => {
        slidetextWords[revealIndex].classList.remove('reveal');
        revealIndex = (revealIndex + 1) % slidetextWords.length;
        slidetextWords[revealIndex].classList.add('reveal');
      }, '3333');
    });
  });
</script>

<style>
	.copyright-footer {
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		padding: 2em 1em 2em 1em;
		color: rgb(var(--gray));
		text-align: center;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}

	.social-links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}

	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}

	.footer {
		display: flex;
		position: relative;
		justify-content: center;
		padding: 1.5em 0;
		width: 100%;
		overflow: hidden;
	}

	.footer-banner-content {
		display: flex;
		position: relative;
		align-items: center;
		gap: 0.5em;
		z-index: 2;
		font-size: 1.2em;
	}

	.footer::before {
		position: absolute;
		top: 0;
		left: -50%;
		z-index: 1;
		transition: transform 1s ease-in-out;
		width: 200%;
		height: 100%;
		content: '';
	}

	.footer:has(.footer-banner-content a:hover)::before {
		transform: scaleX(2);
	}

	.footer-banner-content img {
		width: 30px;
		height: auto;
	}
</style>
