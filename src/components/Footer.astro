---
import HeaderLink from "./HeaderLink.astro";
import config from "../content/config/config.json";
import IconLink from "./react/IconLink";
const today = new Date();
---
<footer class="footer">
	<div class="flex justify-between m-auto">
		<div>
			<a href="/" class="footer-group">
				<img src=`${config.siteLogo}` 
						alt=`${config.siteTitle} logo` 
						width="72" 
						height="72"
						class="footer-group-logo" />
				<div class="footer-group-text">
					<h2>{config.siteTitle}</h2>
					<h3>{config.siteTagline}</h3>
				</div>
			</a>
			<div class="social-links">
				{
					config?.social?.map((url) => {
						return (
							<IconLink {...url} />
						); 
					})
				}
			</div>
		</div>
		<div class="footer-links">
			{
				config.navigation.map((nav) => (
					<HeaderLink href={nav.link} className={nav.classes}>
						{nav.title}
					</HeaderLink>
				))
			}
		</div>
	</div>
	<section class="copyright-footer">
		<div class="copyright">
			&copy; {today.getFullYear()}
			{config.seo.siteOwner}. All rights reserved.
		</div>
		<div class="credit">
			Website by <a href="https://joerhoney.com">joerhoney.com</a>
		</div>
	</section>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slideshows = document.querySelectorAll('.gallery.slideshow');
    
    slideshows.forEach((gallery) => {
      const figures = gallery.querySelectorAll('.gallery-grid figure');
      if (figures.length <= 1) return;
      
      const duration = parseInt(gallery.dataset.slideDuration || '5000');
      let currentIndex = 0;
      
      // First slide already has 'current' class from render
      
      setInterval(() => {
        figures[currentIndex].classList.remove('current');
        currentIndex = (currentIndex + 1) % figures.length;
        figures[currentIndex].classList.add('current');
      }, duration);
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slidetexts = document.querySelectorAll('.slidetext');
    slidetexts.forEach((span) => {
      let revealIndex = 0;
      const words = span.innerText.split(',');
      span.innerText = '';
      words.forEach((str,index) => {
        const word = document.createElement('span');
        word.classList.add('slidetext-word');
				if(index == 0){
          word.classList.add('reveal');
        }
        word.innerText = str.trimStart();
        span.append(word);
      });
      const slidetextWords = span.querySelectorAll('.slidetext-word');

      setInterval(() => {
        slidetextWords[revealIndex].classList.remove('reveal');
        revealIndex = (revealIndex + 1) % slidetextWords.length;
        slidetextWords[revealIndex].classList.add('reveal');
      }, '3333');
    });
  });
</script>

<style>
	.copyright-footer {
		display: flex;
		justify-content: space-between;
		gap: 3rem;
		margin: 0 auto;
		padding: 2em 1em 2em 1em;
		max-width: 1000px;
	}
	.footer {
		position: relative;
		margin: 0;
		padding: 3rem;
		overflow: hidden;
	}
	.footer:before {
		position: absolute;
		opacity: 0.25;
		z-index: -1;
		filter: blur(100px);
		inset: -50px 0 0 0;
		background-image: linear-gradient(130deg, var(--color-1), var(--color-5));
		content: "";
	}
	.footer > * {
		width: 100%;
		max-width: 1000px;
	}
	.footer-group {
		display: flex;
		align-items: stretch;
		margin: 0;
		padding: 0;
	}
	.footer-group-logo {
		margin-right: 1.2rem;
		width: 3rem;
		height: 4.3rem;
	}
	.footer-group-text {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.footer-group {
		color: var(--black);
		text-decoration: none;
	}
	.footer-group-text h2 {
		width: 145px;
		line-height: 1.1;
		font-family: var(--font-serif);
	}
	.footer-group-text h3 {
		width: 7rem;
		font-size: 0.7rem;
		font-family: var(--font-sans);
	}
	h3 {
		margin: 0;
		font-size: 0.8rem;
	}
	h2 {
		margin: 0;
		font-size: 1rem;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.footer-links a {
		border-bottom: 4px solid transparent;
		padding: var(--button-padding);
		color: var(--black);
	}
	.footer-links a.active {
    background: -webkit-linear-gradient(318deg, var(--color-1), var(--color-4));
		-webkit-text-fill-color: transparent;
    -webkit-background-clip: text;
	}
</style>
